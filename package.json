{
  "name": "gymos",
  "version": "0.0.0",
  "private": true,
  "description": "GymOS — coaching-first gym platform. Pilot: single-coach responsive web app with AI meal planning and adaptive progress tracking.",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "node --env-file=.env ./node_modules/turbo/bin/turbo run dev",
    "db:migrate": "pnpm --filter @gymos/db exec node --env-file=\"$INIT_CWD/.env\" --import tsx src/cli/migrate.ts",
    "db:seed": "pnpm --filter @gymos/db exec node --env-file=\"$INIT_CWD/.env\" --import tsx src/cli/seed.ts",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:secrets": "gitleaks git --redact",
    "security:secrets:staged": "gitleaks git --pre-commit --staged --redact",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "fast-check": "^4.9.0",
    "globals": "^17.9.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.7"
  }
}
