# Hoist Expo / RN packages so Metro can resolve them from apps/mobile
# without walking into the pnpm virtual store layout.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=@react-native/*
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=@tamagui/*
