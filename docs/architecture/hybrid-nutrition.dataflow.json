        "focus": ["client", "layer1", "catalog", "solver"],
        "note": "Calories and macros are computed in packages/core, never by a model."
      },
      {
        "id": "restriction-gates",
        "label": "Restriction gates",
        "focus": ["dietary", "catalog", "solver"],
        "note": "Hard-filter the catalog first; a post-generation assertion repeats the same rules."
      },
      {
        "id": "language-and-review",
        "label": "Language then coach",
        "focus": ["solver", "llm", "fallback", "draft"],
        "note": "Layer-3 is optional naming. Generation always lands as DRAFT."
      }
    ]
  },
  "stages": [
    { "label": "Profile" },
