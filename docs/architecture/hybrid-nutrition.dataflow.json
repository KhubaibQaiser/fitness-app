      "from": "llm",
      "to": "draft",
      "label": "meal titles",
      "classification": "language only",
      "variant": "dashed",
      "labelDy": -40
    },
    {
      "id": "template-names",
      "from": "fallback",
      "to": "draft",
      "label": "template titles",
      "classification": "language only",
      "variant": "dashed",
      "labelDx": -72
    },
    {
      "id": "items-persist",
      "from": "solver",
      "to": "draft",
      "label": "foods + portions",
      "classification": "DRAFT row",
      "variant": "emphasis",
      "route": "straight"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Numbers are code",
      "items": [
        "Layer 1 owns BMR/TDEE and safety floors in packages/core",
        "Layer 2 solves one day and clones it to the week (daily_template)"
      ]
    },
    {
      "dot": "rose",
      "title": "Two independent restriction checks",
      "items": [
        "The solver never sees blocked foods; a post-check asserts the same rules",
        "Under-16, pregnancy, and MEDICAL flags block generation without a logged override"
      ]
    },
    {
      "dot": "amber",
      "title": "Language cannot publish",
      "items": [
        "assertDeidentified runs before every Layer-3 call",
        "LLM failure still yields a DRAFT via fallbackNarrative"
      ]
    }
  ]
