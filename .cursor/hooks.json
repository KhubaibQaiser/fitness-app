{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      { "command": "node scripts/agent-hooks/guard.mjs --tool cursor", "timeout": 10 }
    ],
    "beforeReadFile": [
      { "command": "node scripts/agent-hooks/guard.mjs --tool cursor", "timeout": 10 }
    ],
    "stop": [
      {
        "command": "node scripts/agent-hooks/stop-check.mjs --tool cursor",
        "loop_limit": 3,
        "timeout": 600
      }
    ]
  }
}
