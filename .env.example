# GymOS environment template — copy to .env for local development.
# NEVER commit a real .env file. All values below are placeholders.
# Production values are delivered via GitHub Environments secrets → VM env files.

# --- Auth (JWT access + refresh sessions) ---
# Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32
# Pilot coach password used at seed time (hashed into users.password_hash)
PILOT_COACH_PASSWORD=pilot-coach-change-me
# OTP code pepper (required in production). Generate: openssl rand -hex 32
OTP_PEPPER=replace-with-openssl-rand-hex-32
# Resend transactional email (optional locally — OTP prints to API logs)
# RESEND_API_KEY=
EMAIL_FROM=GymOS <onboarding@resend.dev>

# --- Legacy gate (optional — ignored at runtime after JWT cutover; kept for .env compat) ---
# PILOT_ACCESS_KEY=replace-with-openssl-rand-hex-16
# GATE_COOKIE_SECRET=replace-with-openssl-rand-hex-32

# --- Database (Neon in prod; local docker-compose Postgres for dev) ---
DATABASE_URL=postgres://gymos:gymos@localhost:5432/gymos
# pg-boss queue state (host 5434 — avoid clash with local Postgres on 5433)
QUEUE_DATABASE_URL=postgres://gymos:gymos@localhost:5434/gymos_queue

# --- Storage (R2 in prod; local MinIO for dev) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=gymos-media
S3_ACCESS_KEY_ID=local-dev-only
S3_SECRET_ACCESS_KEY=local-dev-only
S3_REGION=auto

# --- AI (Layer 3) ---
# local  = llama.cpp on our infrastructure (production default)
# fallback = deterministic template naming, no LLM (CI default)
# hosted = external OpenAI-compatible API (escape hatch; requires ZDR agreement)
AI_MODE=fallback
AI_BASE_URL=http://localhost:8081/v1
AI_MODEL=qwen3-4b-instruct
# AI_API_KEY is only used in hosted mode; never required for local/fallback

# --- Tenant (pilot: static manifest; path relative to apps/api cwd) ---
TENANT_MANIFEST_PATH=../../infra/tenants/pilot.json

# --- Observability (optional, env-gated) ---
# SENTRY_DSN=
