{
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(!.env.example)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(*.tfstate)",
      "Read(*.tfstate.*)",
      "Read(*.tfvars)",
      "Read(backend.hcl)",
      "Read(credentials*.json)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Edit(scripts/agent-hooks/**)",
      "Edit(.claude/**)",
      "Edit(.github/workflows/**)",
      "Edit(.github/CODEOWNERS)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-hooks/guard.mjs\" --tool claude",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-hooks/stop-check.mjs\" --tool claude",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
