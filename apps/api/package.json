{
  "name": "@gymos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hono modular-monolith API. JWT + refresh sessions; OpenAPI generated from Zod.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi:generate": "tsx src/cli/generate-openapi.ts",
    "dev:pglite": "tsx src/dev-pglite.ts"
  },
  "dependencies": {
    "@gymos/ai": "workspace:^",
    "@gymos/core": "workspace:^",
    "@gymos/db": "workspace:^",
    "@gymos/modules": "workspace:^",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.16",
    "jose": "^6.2.14",
    "pdfkit": "^0.20.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^26.1.2",
    "@types/pdfkit": "^0.17.7",
    "drizzle-orm": "^0.45.4",
    "vitest": "^3.2.7"
  }
}
